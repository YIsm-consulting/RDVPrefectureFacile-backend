# ============================================================
# RDVPrefectureFacile — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS COMMITTER le fichier .env sur GitHub
# ============================================================

# Serveur
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://rdvprefecturefacile.fr
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire_minimum_32_caracteres

# Supabase (base de données)
# Créez un projet sur supabase.com → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5...

# Stripe (paiements)
# dashboard.stripe.com → Développeurs → Clés API
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxxx

# Twilio (SMS)
# console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+33xxxxxxxxx

# SendGrid (Email)
# app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
FROM_EMAIL=alertes@rdvprefecturefacile.fr
FROM_NAME=RDVPrefectureFacile

# Robot scraper
SCRAPER_INTERVAL_MINUTES=2
SCRAPER_HEADLESS=true
MAX_CONCURRENT_SCRAPERS=5
